/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
    
public:
    ListNode* tail (ListNode* head) {
        ListNode* temp=head;
        if (head!=nullptr)
            {while(temp->next!=nullptr) {
                temp=temp->next;
            }
            return temp;
            }
        else {
            return nullptr;
        }
    }
    int size (ListNode* head) {
        int ct = 0;
        ListNode* temp=head;
        if (head!=nullptr)
            {while(temp!=nullptr) {
                temp=temp->next;
                ct++;
            }
            return ct;
            }
        else {
            return ct;
        }

    }
    ListNode* penultimo_nodo (ListNode* head) {
        ListNode* temp = head;
        if (head!=nullptr) {
        while (temp->next->next!=nullptr) {
            temp=temp->next;
        }
        return temp;}
        else {
            return nullptr;
        }
    }
    ListNode* rotateRight(ListNode* head, int k) {
        //ListNode* dummy=head;
        if (head==nullptr || head->next==nullptr) {return head;}
        for (int i=0; i<k%size(head);i++) {
            ListNode* ultimo= tail (head);
            ListNode* penultimo = penultimo_nodo (head);
            ultimo->next=head;
            penultimo->next = nullptr;
            head=ultimo;
        }
        return head;
    }
};
